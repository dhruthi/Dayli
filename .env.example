# ==========================================================================
#  dayli.ai — Environment Configuration
# ==========================================================================
#
#  ⚠️  READ THIS BEFORE DEPLOYING
#
#  Anything prefixed with VITE_ is INLINED INTO THE CLIENT JAVASCRIPT BUNDLE
#  and is publicly readable by anyone who opens devtools on your site.
#
#  Therefore:
#    • VITE_ prefix  → safe-to-publish values ONLY (feature flags, public IDs)
#    • no prefix     → real secrets. Read only by /api/* serverless functions.
#
#  On Vercel, set the server-only vars under Project → Settings → Environment
#  Variables. Never commit a filled-in .env.
# ==========================================================================


# ─── SERVER-ONLY SECRETS (never VITE_ prefixed) ───────────────────────────

# Meta WhatsApp Business Cloud API
# System User token from Meta Business Suite. Use a permanent System User token,
# NOT the 24-hour temporary token from the dashboard's Getting Started tab.
META_WHATSAPP_ACCESS_TOKEN=EAAG...your_permanent_system_user_token

# WhatsApp → API Setup → "Phone number ID" (a numeric ID, NOT the phone number)
META_WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Any string you invent. You type the same value into Meta's webhook config form.
META_WHATSAPP_VERIFY_TOKEN=dayli_ai_webhook_verify_token_2026

# App Dashboard → Settings → Basic → App Secret. Used for HMAC SHA-256 validation
# of inbound webhooks. If left blank, signature checking is SKIPPED — never ship
# to production without this set.
META_WHATSAPP_APP_SECRET=your_meta_app_secret_hash

# Shared secret protecting POST /api/send-alert. Generate with:
#   openssl rand -hex 32
DAYLI_INTERNAL_API_KEY=generate_a_long_random_string

# OpenAI inference key. Must start with "sk-" — there is no default and no
# fallback provider, so leaving this unset disables AI replies rather than
# quietly using someone else's key.
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000

# Weather / climate data provider
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_PROVIDER_TYPE=auto
WEATHER_CACHE_TTL_MINUTES=10

# Message provider: "mock" (simulator) | "meta" (live Cloud API)
MESSAGE_PROVIDER=meta


# ─── CLIENT-SAFE VALUES (VITE_ prefixed — these WILL be public) ───────────

# Controls what the in-browser simulator UI does. Keep this on "mock" so the
# demo portal never attempts a real send from the browser.
VITE_MESSAGE_PROVIDER=mock

# Public display value only — safe to expose.
VITE_WEATHER_PROVIDER_TYPE=auto

# NOTE: VITE_META_WHATSAPP_ACCESS_TOKEN, VITE_META_WHATSAPP_APP_SECRET and
# VITE_OPENAI_API_KEY have been deliberately REMOVED. Setting them ships your
# credentials to every visitor, because Vite inlines VITE_-prefixed values
# into the browser bundle. Real sends now go through the server route
# POST /api/send-alert instead.
