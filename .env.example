# ==============================================================================
# Dayli AI — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` before deploying:
#   cp .env.example .env
#
# See `docs/WHATSAPP_DEPLOYMENT_RUNBOOK.md` for full deployment instructions.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & DOMAIN CONFIGURATION (Cloud VPS + Caddy Reverse Proxy)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Public domain pointing to your company VPS (used by Caddy for automatic HTTPS)
DOMAIN_NAME=api.dayli.ai
ACME_EMAIL=admin@dayli.ai

# Public HTTPS origin of the WhatsApp backend (used for serving sticker assets)
PUBLIC_BASE_URL=https://api.dayli.ai

# Exact comma-separated browser origins allowed by CORS
ALLOWED_ORIGINS=https://dayli.ai,https://dashboard.dayli.ai

# ------------------------------------------------------------------------------
# 2. META WHATSAPP BUSINESS CLOUD API (REQUIRED)
# Account: https://business.facebook.com & https://developers.facebook.com
# ------------------------------------------------------------------------------
# Numeric Phone Number ID from Meta App Dashboard -> WhatsApp -> API Setup
META_WHATSAPP_PHONE_NUMBER_ID=

# Permanent System User access token (scopes: whatsapp_business_messaging, whatsapp_business_management)
META_WHATSAPP_ACCESS_TOKEN=

# Custom secret string you invent and enter in Meta App -> WhatsApp -> Configuration -> Webhook
META_WHATSAPP_VERIFY_TOKEN=

# App Secret from Meta App Dashboard -> Settings -> Basic (verifies x-hub-signature-256)
META_WHATSAPP_APP_SECRET=

# Pinned Meta Graph API version
META_GRAPH_VERSION=v21.0

# Pre-approved WhatsApp template name used to re-engage users outside the 24h window
META_REENGAGEMENT_TEMPLATE=daily_climate_alert

# Public dialable WhatsApp number (digits only, no '+') for website CTA links
WHATSAPP_DISPLAY_NUMBER=918431061497
VITE_WHATSAPP_NUMBER=918431061497

# Used by artifacts/api-server to HMAC-hash phone numbers in Postgres (generate: openssl rand -hex 32)
META_WHATSAPP_HASH_SALT=

# ------------------------------------------------------------------------------
# 3. AI INFERENCE PROVIDERS (At least one cloud key required unless DAYLI_CORE_MODE=local)
# ------------------------------------------------------------------------------
# Execution mode:
#   - "hybrid" (default): Local router + local Ollama MedGemma first, cloud frontier fallback
#   - "local": 100% local in-process router + Ollama MedGemma (zero external AI API calls)
DAYLI_CORE_MODE=hybrid

# Primary Cloud LLM (configure ONE of OpenAI, Groq, or xAI):
# OpenAI (https://platform.openai.com) — keys starting with sk-
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
# OpenAI TTS (uses same API key above) — primary voice reply provider
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=nova

# GroqCloud (https://console.groq.com) — keys starting with gsk_
GROQ_API_KEY=

# xAI (https://console.x.ai) — keys starting with xai-
XAI_API_KEY=

# Google Gemini (https://aistudio.google.com) — LLM fallback, Multimodal Voice ASR, TTS, and 5-day Risk Briefs
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ASR_MODEL=gemini-2.0-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Local Ollama MedGemma (runs automatically in docker-compose.prod.yml)
DAYLI_LOCAL_LLM=on
DAYLI_LOCAL_MODEL=medgemma:latest
DAYLI_OLLAMA_URL=http://ollama:11434

# ------------------------------------------------------------------------------
# 4. MULTILINGUAL VOICE (ASR & TTS) — OPTIONAL / RECOMMENDED
# ------------------------------------------------------------------------------
VOICE_REPLY_ENABLED=true

# Project Bhashini / ULCA (https://dashboard.bhashini.co.in) — Indian language ASR & TTS
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Optional direct Dhruva inference key (if issued directly by Bhashini)
BHASHINI_INFERENCE_API_KEY=
BHASHINI_VOICE_GENDER=female

# Sarvam AI (https://sarvam.ai) — Indian language ASR (Saaras v3) & TTS (Bulbul v3)
SARVAM_API_KEY=
# SARVAM_TTS_SPEAKER=kavya
# INDIAN_VOICE_PRIORITY=sarvam,bhashini

# ElevenLabs (https://elevenlabs.io) — Expressive multilingual voiceover TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ------------------------------------------------------------------------------
# 5. REDIS SESSION STORE & INTERNAL / DASHBOARD SECURITY
# ------------------------------------------------------------------------------
# Redis URL (in docker-compose.prod.yml this is automatically set to redis://redis:6379)
SESSION_STORE_URL=redis://localhost:6379
SESSION_TTL_SECONDS=2592000

# Internal API key protecting /ops/*, /api/send-alert, and /internal/aurora/forecast
# Generate with: openssl rand -hex 32
DAYLI_INTERNAL_API_KEY=

# Standalone Ops Dashboard (ops-dashboard/) access key
DASH_ACCESS_KEY=

# Clinical Surveillance Portal (/dashboard & /login) credentials
DASHBOARD_USERNAME=clinical@dayli.ai
DASHBOARD_PASSWORD=
SESSION_SECRET=

# ------------------------------------------------------------------------------
# 6. WEATHER & CLIMATE PROVIDERS
# ------------------------------------------------------------------------------
# Open-Meteo is used by default and requires NO API key.
WEATHER_PROVIDER_TYPE=real

# ------------------------------------------------------------------------------
# 7. MARKETING WEBSITE & API SERVER (artifacts/api-server & artifacts/dayli-website)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for website lead-capture forms & web chat logs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dayli

# Basic Auth password for /admin/leads on the marketing website
LEADS_ADMIN_PASSWORD=

# OpenAI integration variables for the marketing website chat demo (/api/chat)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
