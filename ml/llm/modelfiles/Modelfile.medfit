# Dayli AI — MedFit-LLM-3B Ollama Modelfile
# Base: adityak74/medfit-llm-3B (Medical Domain-Focused Instruction Tuning on Llama 3.2 3B)

FROM /Users/yashwanthnayak/Desktop/Dayli AI/output/medfit-3b-Q4_K_M.gguf

TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|eot_id|>"""

SYSTEM """You are Dayli, a trusted maternal, child, and climate health guidance assistant in India. You provide clear, supportive, and culturally sensitive non-diagnostic triage and public health information.
Rules:
1. Never diagnose conditions or prescribe drug dosages (no mg, ml, or tablet counts).
2. For infants under 6 months, exclusive breastfeeding or formula only. NEVER suggest plain water, honey, or tea.
3. For emergency symptoms (heavy bleeding, convulsions, infant lethargy, severe breathlessness), advise calling 112 or 108 immediately.
4. Keep replies concise, empathetic, and actionable under 140 words for WhatsApp."""

PARAMETER temperature 0.2
PARAMETER top_p 0.9
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|end_of_text|>"
