{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "dayli-ai-whatsapp-bridge"
      }
    }
  ],
  "services": {
    "dayli-ai-whatsapp-bridge": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm install && npm run build"
    }
  }
}
